diff --git a/src/lib/kelas-terpilih.ts b/src/lib/kelas-terpilih.ts
new file mode 100644
index 0000000..d106bc3
--- /dev/null
+++ b/src/lib/kelas-terpilih.ts
@@ -0,0 +1,15 @@
+// Penanda eksplisit di URL (?kelas=belum) untuk mahasiswa yang belum punya kelas.
+// Parameter `kelas` yang TIDAK ada berarti "belum memilih", sehingga default ke kelas pertama.
+// Keduanya harus dibedakan, kalau tidak opsi "Belum ditentukan" selalu terlempar ke Kelas A.
+export const KELAS_BELUM = "belum";
+
+/**
+ * Menentukan kelas yang ditampilkan dari parameter URL.
+ * - "belum"              -> null (mahasiswa yang belum punya kelas)
+ * - id kelas yang valid  -> kelas itu
+ * - kosong / tidak dikenal -> kelas pertama (null bila MK belum punya kelas)
+ */
+export function pilihKelas<T extends { id: string }>(daftarKelas: T[], param: string | undefined): T | null {
+  if (param === KELAS_BELUM) return null;
+  return daftarKelas.find((kelas) => kelas.id === param) ?? daftarKelas[0] ?? null;
+}
diff --git a/tests/kelas-terpilih.test.ts b/tests/kelas-terpilih.test.ts
new file mode 100644
index 0000000..dc031de
--- /dev/null
+++ b/tests/kelas-terpilih.test.ts
@@ -0,0 +1,26 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { KELAS_BELUM, pilihKelas } from "../src/lib/kelas-terpilih";
+
+const daftar = [{ id: "kelasA" }, { id: "kelasB" }];
+
+test("pilihKelas: tanpa parameter default ke kelas pertama", () => {
+  assert.equal(pilihKelas(daftar, undefined)?.id, "kelasA");
+});
+
+test("pilihKelas: 'belum' menampilkan mahasiswa tanpa kelas, bukan kelas pertama", () => {
+  assert.equal(pilihKelas(daftar, KELAS_BELUM), null);
+});
+
+test("pilihKelas: id kelas yang valid dipilih apa adanya", () => {
+  assert.equal(pilihKelas(daftar, "kelasB")?.id, "kelasB");
+});
+
+test("pilihKelas: id tidak dikenal jatuh ke kelas pertama", () => {
+  assert.equal(pilihKelas(daftar, "sudah-dihapus")?.id, "kelasA");
+});
+
+test("pilihKelas: MK tanpa kelas selalu menghasilkan null", () => {
+  assert.equal(pilihKelas([], undefined), null);
+  assert.equal(pilihKelas([], KELAS_BELUM), null);
+});
