# Salin file ini menjadi .env lalu isi nilainya. File .env tidak boleh di-commit.

# Koneksi PostgreSQL (Prisma + adapter-pg)
DATABASE_URL="postgresql://postgres:password@localhost:5432/evaluasi-db"

# Rahasia untuk menandatangani sesi login dan meng-hash OTP/token reset.
# Buat nilai acak yang panjang, mis.:  npx auth secret   atau   openssl rand -base64 32
AUTH_SECRET=""

# Email pengirim kode OTP reset sandi Admin (Gmail + App Password, bukan sandi akun biasa)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
